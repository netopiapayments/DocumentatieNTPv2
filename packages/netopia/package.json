{
  "name": "netopia",
  "version": "0.1.0",
  "private": true,
  "description": "Client NETOPIA Payments API v2 (fără dependențe) + CLI `npx netopia init` pentru integrare automată în Next.js / Express.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "netopia": "./bin/netopia.js"
  },
  "files": [
    "src",
    "bin",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "sync:reference": "node scripts/sync-reference.js"
  },
  "keywords": [
    "netopia",
    "mobilpay",
    "payments",
    "card",
    "romania"
  ],
  "license": "UNLICENSED"
}
